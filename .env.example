# Homebrew Shelf environment template.
# Copy to .env and edit. Values here are the initial defaults; settings you change
# in the web UI are saved to SQLite and take precedence afterwards.
# Keep .env private (chmod 600) and out of source control: dotenv is plaintext.

# ---------------------------------------------------------------------------
# Compose / storage (read by docker-compose.yml)
# ---------------------------------------------------------------------------
# Host port for the UI/API. Container always listens on 8420.
# SHELF_PORT=8420
# Host path bind-mounted to /data inside the container. Needs to be writable by UID 1000.
# SHELF_DATA=./shelf-data
# Name of the external reverse-proxy network to join (optional). Defaults to "proxy".
# Create it with: docker network create proxy
# PROXY_NETWORK=proxy

# In-container data root (rarely changed). Subfolders: inbox, library, work, failed, icons.
# DATA_DIR=/data
# Path to the Shop catalog. Compose mounts ./catalog here read-only; put your
# operator-supplied GAMES.json inside ./catalog (it is gitignored, never bundled).
# CATALOG_PATH=/app/catalog/GAMES.json
# Path to LibOrbisPkg's PkgTool.Core (only relevant outside the official image).
# PKGTOOL=/opt/pkgtool/PkgTool.Core

# ---------------------------------------------------------------------------
# Console connection (initial defaults; editable in the UI)
# ---------------------------------------------------------------------------
# PS4_HOST is the console's LAN IP.
# PS4_HOST=
# PS4_FTP_PORT=2121
# Destination folder ON THE CONSOLE for FTP uploads.
# PS4_FTP_DIR=/data/pkg
# PS4_FTP_USER=anonymous
# PS4_FTP_PASS=
# PS4_RPI_PORT=12800
# This server's address as the console sees it (LAN IP, not the tailnet name).
# Required for RPI installs and the FPKGi endpoint.
# PUBLIC_URL=
# What to do automatically once a PKG lands: none | ftp | rpi | auto.
# AUTO_SEND=none

# ---------------------------------------------------------------------------
# Notifications
# ---------------------------------------------------------------------------
# Optional http(s) webhook (Slack/Discord incoming webhook) POSTed when a job reaches
# done or failed. Empty disables. Editable in the UI.
# NOTIFY_WEBHOOK=

# ---------------------------------------------------------------------------
# Internet Archive downloads
# ---------------------------------------------------------------------------
# Your Internet Archive account email (not your screen name) and password.
# Quote passwords containing '#' or spaces.
# ARCHIVE_USER=
# ARCHIVE_PASS=

# ---------------------------------------------------------------------------
# aria2 parallel downloader / stall guard
# ---------------------------------------------------------------------------
# Max connections per server (default 8).
# ARIA2_CONN=8
# Fail a download that allocates no new bytes for this many seconds (default 180).
# STALL_SECONDS=180
# aria2 --lowest-speed-limit; K/M suffixes allowed (default 100K).
# MIN_DOWNLOAD_RATE=100K
# A transfer that has allocated at least this % of its size ignores the speed/stall guard
# and is allowed to finish (default 95).
# FINISH_NEAR_COMPLETE_PCT=95
# Verify archive.org downloads against the item metadata's md5/sha1/crc32 (default on).
# VERIFY_CHECKSUM=1
# Retries for transient download failures before giving up; backoff is 60/300/900 s (default 3).
# MAX_RETRIES=3

# ---------------------------------------------------------------------------
# Bandwidth scheduling
# ---------------------------------------------------------------------------
# Hold the fetch worker while any send_ftp/send_rpi/send_auto job is running: both saturate
# the same WiFi link. Editable in the UI; default true.
# PAUSE_DOWNLOAD_WHILE_SENDING=1

# ---------------------------------------------------------------------------
# Download allow-list (SSRF guard) / safety limits
# ---------------------------------------------------------------------------
# Comma-separated hosts allowed for POST /api/download; a leading dot also matches
# subdomains. Ignored when ALLOW_ANY_DOWNLOAD=1.
# ALLOWED_DOWNLOAD_HOSTS=archive.org,.archive.org
# Accept any http(s) host. DANGEROUS: disables the SSRF guard.
# ALLOW_ANY_DOWNLOAD=0

# Cap a single browser upload, in GiB (default 200).
# MAX_UPLOAD_GB=200
# Reject an archive extraction larger than this, in GiB, after unar
# (decompression-bomb guard; default 300).
# EXTRACT_MAX_GB=300
